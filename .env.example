# PostgreSQL connection
PSQL_USER=
PSQL_HOST=
PSQL_DATABASE=
PSQL_PASSWORD=
PSQL_PORT=5432
# Set true only when your PostgreSQL host requires SSL.
PSQL_SSL=false

# Session security (use a long, random value)
SESSION_SECRET=

# Server
PORT=3000

# For local review, use `npm run demo` instead of setting this by hand.
# Demo mode uses fictional, disposable data and listens on 127.0.0.1 only.
# DEMO_MODE=1

# Google OAuth
CLIENT_ID=
CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# OpenWeather API
OPENWEATHER_API_KEY=

# Used only by example.mjs
OPENAI_API_KEY=
